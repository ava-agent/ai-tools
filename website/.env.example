# 环境变量配置示例
# 复制此文件为 .env 并根据实际环境配置

# 应用配置
VITE_APP_TITLE=AI工具全书
VITE_APP_DESCRIPTION=2026深度集成与实战教学版 - AI工具选型指南

# API 配置（如果需要）
# VITE_API_BASE_URL=https://api.example.com
# VITE_API_KEY=your_api_key_here

# 分析配置（如果需要）
# VITE_ENABLE_ANALYTICS=true
# VITE_ANALYTICS_ID=your_analytics_id

# 开发配置
VITE_DEV_MODE=true
VITE_DEV_PORT=3000

# 生产配置
VITE_PROD_MODE=false
VITE_PROD_URL=https://ai-tools.example.com
